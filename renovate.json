{
  "extends": [
    "config:recommended"
  ],
  "configMigration": true,
  "packageRules": [
    {
      "matchPackageNames": ["ghcr.io/home-assistant/home-assistant"],
      "assignees": ["fritzm"],
      "reviewers": ["fritzm"]
    },
    {
      "matchPackageNames": ["keda"],
      "assignees": ["dspeck1"],
      "reviewers": ["dspeck1"]
    },
    {
      "matchPackageNames": ["lsstsqre/tap-schema-mock"],
      "allowedVersions": "<10"
    },
    {
      "description": "ClickHouse for river-next: LTS releases (YY.3 and YY.8) only. An upgrade cannot be rolled back once the server writes data.",
      "matchFileNames": ["applications/river-next/**"],
      "matchPackageNames": ["clickhouse/clickhouse-server"],
      "allowedVersions": "/^[0-9]+\\.(3|8)\\./"
    },
    {
      "matchPackageNames": ["weaviate"],
      "assignees": ["jhu-s", "emanehab99"],
      "reviewers": ["jhu-s", "emanehab99"]
    }
  ],
  "rebaseWhen": "conflicted",
  "schedule": [
    "before 6am on Monday"
  ],
  "timezone": "America/Los_Angeles"
}
